generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos en Prisma; se documentan como comentario
// y se validan en la capa de aplicación (lib/validation.ts).
// EstadoEvento: COTIZACION | CONFIRMADO | CANCELADO
// TipoRecurso: PERSONAJE | EQUIPO | PERSONAL
// EstadoSolicitud: NUEVA | CONTACTADA | CONVERTIDA | DESCARTADA
// TipoOpcion: VARIANTE | DINAMICA

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  email     String?
  createdAt DateTime @default(now())
  eventos   Evento[]
}

model Evento {
  id          String       @id @default(cuid())
  fecha       String // YYYY-MM-DD
  horaInicio  String // HH:mm
  horaFin     String // HH:mm
  tipo        String
  ubicacion   String?
  estado      String       @default("COTIZACION")
  notas       String?
  clienteId   String
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  servicios   EventoServicio[]
  recursos    EventoRecurso[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Secciones del catálogo. Servicio.categoria guarda el nombre (al renombrar se actualizan los servicios).
model Categoria {
  id     String @id @default(cuid())
  nombre String @unique
  color  String @default("#a8ff30")
  orden  Int    @default(0)
}

model Servicio {
  id          String   @id @default(cuid())
  categoria   String
  activo      Boolean  @default(true) // false = oculto en el sitio, sin borrarlo
  nombre      String
  descripcion String
  fotoUrl     String?
  orden       Int      @default(0)
  incluye     String?
  edadIdeal   String?
  duracion    String?
  masPedido   Boolean  @default(false)
  destacado   Boolean  @default(false)
  soloAdultos Boolean  @default(false)
  enPdf       Boolean  @default(true) // false = se ve en la web pero no en el catálogo PDF
  ocasiones   String?  // cumpleanos, baby-shower, quince, boda, corporativo, graduacion, navidad
  combinaCon  String?  // IDs separados por comas
  eventos     EventoServicio[]
  opciones    Opcion[]
  media       ServicioMedia[]
}

model ServicioMedia {
  id         String   @id @default(cuid())
  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  url        String
  tipo       String   // FOTO | VIDEO
  poster     String?
  orden      Int      @default(0)
}

// Variantes de un personaje (agrupadas por "grupo", ej. "Rapunzel": sola / con
// el príncipe / con todos los personajes) o dinámicas/juegos seleccionables
// de un servicio tipo evento (ej. "Baby Shower": 7+ juegos con video corto).
model Opcion {
  id          String   @id @default(cuid())
  servicioId  String
  servicio    Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  tipo        String // VARIANTE | DINAMICA
  grupo       String? // nombre del personaje al que pertenece (solo VARIANTE)
  nombre      String
  descripcion String?
  videoUrl    String?
  fotoUrl     String?
  orden       Int      @default(0)
}

model EventoServicio {
  eventoId   String
  servicioId String
  evento     Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@id([eventoId, servicioId])
}

model Recurso {
  id            String      @id @default(cuid())
  nombre        String
  tipo          String
  cantidadTotal Int         @default(1)
  fotoUrl       String?
  eventos       EventoRecurso[]
}

model EventoRecurso {
  eventoId      String
  recursoId     String
  cantidadUsada Int     @default(1)
  evento        Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  recurso       Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@id([eventoId, recursoId])
}

model SolicitudContacto {
  id           String          @id @default(cuid())
  nombre       String
  telefono     String
  email        String?
  mensaje      String
  fechaDeseada String?
  estado       String          @default("NUEVA")
  createdAt    DateTime        @default(now())
}

model Recreador {
  id          String   @id @default(cuid())
  nombre      String
  cargo       String
  descripcion String
  fotoUrl     String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
}

model Novedad {
  id          String    @id @default(cuid())
  badge       String
  titulo      String
  descripcion String
  fotoUrl     String?
  ctaTexto    String    @default("Consultar disponibilidad")
  ctaUrl      String?
  activo      Boolean   @default(true)
  fechaInicio DateTime?
  fechaFin    DateTime?
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  usuario      String @unique
  passwordHash String
}

// Ajustes generales del sitio, editables desde /admin/ajustes (una sola fila).
model ConfiguracionSitio {
  id            String   @id @default("principal")
  whatsapp      String // solo dígitos con código de país, ej. 584147286881
  datosPago     String? // cuentas para el anticipo (pago móvil, Zelle…), las ve el cliente en su reserva
  eventosPorDia Int      @default(3) // tope de fiestas por día para ofrecer una fecha como disponible
  cifras          String? // JSON {fiestas, anios, ciudades}: números de confianza del Inicio (vacío = no se muestran)
  preciosPaquetes String? // JSON {"<ruta>/<paquete>": US$}: precio «desde» de cada paquete de /fiestas
  updatedAt     DateTime @updatedAt
}

// Opiniones reales de clientes (con su permiso). Se muestran en el Inicio y en las páginas por ocasión.
model Testimonio {
  id        String   @id @default(cuid())
  nombre    String
  evento    String // «Cumpleaños de Sofía», «Fin de año de Empresa X»
  ciudad    String?
  texto     String
  fotoUrl   String?
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
}

// Fecha apartada desde la web. El cliente la sigue con su enlace privado (token); el equipo
// pone el monto del anticipo, revisa el comprobante y al confirmar se crea el Evento.
// estado: SOLICITADA | ESPERANDO_PAGO | PAGO_REPORTADO | CONFIRMADA | RECHAZADA
model Reserva {
  id             String   @id @default(cuid())
  codigo         String   @unique // DV-4821: para hablar por WhatsApp
  token          String   @unique // enlace privado del cliente
  estado         String   @default("SOLICITADA")
  fecha          String // YYYY-MM-DD
  horaInicio     String?
  tipoEvento     String
  zona           String
  lugar          String?
  invitados      String?
  nombre         String
  telefono       String
  email          String?
  comentarios    String?
  servicios      String? // JSON: [{ servicioId, nombre, variante }] de «Mi fiesta»
  montoAnticipo  Float?
  montoTotal     Float?
  metodoPago     String?
  referenciaPago String?
  comprobante    String? // nombre del archivo en UPLOADS_DIR/comprobantes (privado)
  notaInterna    String?
  eventoId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Medición propia del sitio (sin servicios externos ni cookies de terceros).
// tipo: VISITA | WHATSAPP | COTIZACION | INSTAGRAM
// visitante: id anónimo aleatorio guardado en el navegador, para contar personas y no recargas.
model Metrica {
  id        String   @id @default(cuid())
  tipo      String
  origen    String? // dónde se tocó: ficha, boton-flotante, pie, catalogo, consulta-fecha...
  detalle   String? // servicio o servicios relacionados
  pagina    String?
  visitante String?
  createdAt DateTime @default(now())

  @@index([tipo, createdAt])
  @@index([createdAt])
}
